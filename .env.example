APP_NAME=media-gen-service
APP_ENV=development
APP_DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=8000

# 开发环境可留空；production 必须配置，请求头使用 X-API-Key
API_KEYS=
CORS_ORIGINS=*

# development 允许没 Key 时回退 mock；production 必须为 false 并配置真实 Key
ALLOW_MOCK_PROVIDERS=true
# 本地 memory 队列默认内嵌 Worker；production 必须 false，并单独启动 python -m app.worker
# EMBEDDED_WORKER=false

QUEUE_BACKEND=memory
REDIS_URL=redis://127.0.0.1:6379/0
QUEUE_NAME=media-gen:jobs

TASK_BACKEND=sqlite
SQLITE_PATH=./data/tasks.db

STORAGE_BACKEND=local
STORAGE_DIR=./data/media
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
S3_PUBLIC_BASE_URL=

# 真实 Key 只写本机 .env，不要写进本文件（会被提交）
# 国内站: https://dashscope.aliyuncs.com/compatible-mode/v1
# 国际站: https://dashscope-intl.aliyuncs.com/compatible-mode/v1
LLM_PROVIDER=openai_compat
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=
LLM_MODEL=qwen3.8-max

# 国内站: https://dashscope.aliyuncs.com/api/v1
# 国际站: https://dashscope-intl.aliyuncs.com/api/v1
# IMAGE_API_KEY 可留空，dashscope 会复用 LLM_API_KEY
# 切回 DALL·E: IMAGE_PROVIDER=openai_compat 且 IMAGE_BASE_URL=https://api.openai.com/v1
IMAGE_PROVIDER=dashscope
IMAGE_BASE_URL=https://dashscope.aliyuncs.com/api/v1
IMAGE_API_KEY=
IMAGE_MODEL=qwen-image-3.0
IMAGE_SIZE=1024*1024

# VIDEO_API_KEY 可留空，dashscope 会复用 LLM_API_KEY
# 切回通用 HTTP 厂商: VIDEO_PROVIDER=http 并填写 VIDEO_BASE_URL
VIDEO_PROVIDER=dashscope
VIDEO_BASE_URL=https://dashscope.aliyuncs.com/api/v1
VIDEO_API_KEY=
VIDEO_MODEL=wan3.0-video
VIDEO_IMAGE_TO_VIDEO_PATH=/v1/video/image-to-video
VIDEO_VIDEO_TO_VIDEO_PATH=/v1/video/video-to-video
VIDEO_TASK_PATH=/v1/video/tasks/{task_id}
VIDEO_POLL_INTERVAL_SECONDS=15
VIDEO_POLL_TIMEOUT_SECONDS=600

MAX_UPLOAD_MB=80
SYNC_WAIT_TIMEOUT_SECONDS=180
CHAT_HISTORY_LIMIT=20
